# Copiar a .env.local
# Solo servidor: adónde reenvía proxy.ts las llamadas /api/*
BACKEND_URL=http://localhost:3101
# Llave pública de Wompi (se incrusta al compilar: cambiarla exige un build nuevo)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=

# WhatsApp de contacto de la página de presentación (solo dígitos, con 57). Sin él, los botones llevan a #contacto.
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Link del archivo de Android (APK) para el botón "Descargar" de la página de presentación.
NEXT_PUBLIC_ANDROID_APK_URL=
