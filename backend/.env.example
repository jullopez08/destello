# Copiar a .env (no se sube a git)
DATABASE_URL=postgresql://destello:destello123@localhost:5434/destello?schema=public
PORT=3101
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1d
# Links de los correos y CORS (puede llevar varias separadas por coma)
FRONTEND_URL=http://localhost:3100
APP_TIMEZONE=America/Bogota

# Correos (Resend). Sin llave, los correos no salen pero la app funciona.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEGAL_EMAIL=

# Logos (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Wompi. Sin llaves, /payments responde 503 y el resto funciona.
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
