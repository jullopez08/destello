generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Plataforma
// Organization = la pastelería / panadería / cocina oculta (el tenant).
// User         = SUPER_ADMIN (sin empresa) o ADMIN = la dueña de una empresa.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id               String    @id @default(cuid())
  name             String
  /// Identificador para URLs (p. ej. "cocina-destello")
  slug             String    @unique
  active           Boolean   @default(true)
  /// Logo subido a Cloudinary
  logoUrl          String?
  /// Paleta del panel elegida por la dueña: vainilla | fresa | lavanda | menta | durazno | cielo
  palette          String    @default("vainilla")
  /// "¿Atiendes clientes en mesas?" (Julieth, 2026-10-19): enciende mesas y meseros. Pastelería, panadería,
  /// cocina oculta o restaurante da igual: todas tienen pedidos, domicilios, recetas y pantalla de cocina.
  servesTables     Boolean   @default(false)
  /// Minutos que suele tardar un plato y el máximo antes de avisar a la mesa (pantalla de cocina y mesero)
  kitchenNormalMin Int       @default(15)
  kitchenMaxMin    Int       @default(25)
  /// Impuesto que cobra el negocio, ya incluido en sus precios: NONE (no responsable), INC (consumo 8 %) o IVA (19 %, franquicias)
  salesTax         SalesTax  @default(NONE)
  /// Inscrita sola con SIGNUP_MODE=review: no entra a la cocina hasta que el super admin la apruebe
  approvalPending  Boolean   @default(false)
  /// Cuándo el super admin comprobó que el negocio es real (Instagram o Maps y la carta); null = por verificar.
  /// En modo `open` trabaja normal mientras tanto (Julieth, 2026-10-21).
  verifiedAt       DateTime?
  /// "No es real": la cuenta queda en pausa con sus datos hasta que el super admin la verifique
  rejectedAt       DateTime?

  // Datos de la cocina (Configuración)
  whatsapp         String?
  /// Instagram o Google Maps que dio al inscribirse (el super admin lo revisa antes de aprobar)
  findUs           String?
  /// "HH:mm": los pedidos tomados después pasan al siguiente día de producción
  orderCutoff      String    @default("12:00")
  /// Días en que el negocio está cerrado (no produce ni entrega), 0 = domingo … 6 = sábado
  closedDays       Int[]     @default([0])
  /// Margen que busca la dueña (%), para el precio sugerido
  targetMargin     Int       @default(50)
  nextOrderNumber  Int       @default(1001)
  /// Cuándo terminó los primeros pasos (negocio, receta, llave Bre-B y repartidor).
  /// Mientras sea null, el panel solo muestra los primeros pasos.
  setupCompletedAt DateTime?

  /// Cuándo se borran todos los datos de la empresa (6 meses después de quedar inactiva).
  /// Lo fija y lo limpia DataRetentionCron cada día.
  dataDeletionScheduledAt DateTime?
  /// Avisos ya enviados para esa fecha: 0 ninguno, 1 al programarse, 2 un mes antes, 3 una semana antes.
  dataDeletionNoticesSent Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  users            User[]
  cashShifts       CashShift[]
  cashMoves        CashMove[]
  staff            StaffMember[]
  tables           DiningTable[]
  tableSessions    TableSession[]
  menu             BusinessMenu?
  tablePayments    TablePayment[]
  kitchenTickets   KitchenTicket[]
  subscription     Subscription?
  bankAccounts     BankAccount[]
  couriers         Courier[]
  suppliers        Supplier[]
  supplies         Supply[]
  purchases        Purchase[]
  recipes          Recipe[]
  doughLots        DoughLot[]
  doughWaste       DoughWaste[]
  supplyBatches    SupplyBatch[]
  supplyWaste      SupplyWaste[]
  products         Product[]
  presentations    Presentation[]
  orders           Order[]
  editions         Edition[]
  productionChecks ProductionCheck[]
}

/// Mesero (su celular, con PIN) o pantalla de cocina (tablet fija). No tienen correo ni contraseña: entran
/// con un enlace de invitación de un solo uso que amarra el aparato (StaffDevice). Fase 3, 2026-10-19.
enum StaffRole {
  WAITER
  KITCHEN
}

// ── Restaurante (Fase 3, `feature/mesas-comanda`, 2026-10-19) ──
// Mesa → se abre (TableSession, con su mesero) → cada "Enviar a cocina" es una comanda (KitchenTicket) con sus
// líneas del mismo catálogo de "Lo que vendes" y el precio del momento. Listo (cocina) y cerrar mesa vienen después.

model DiningTable {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  position       Int
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  sessions     TableSession[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

model TableSession {
  id             String             @id @default(cuid())
  organizationId String
  tableId        String
  /// Mesero que la abrió (null si la abrió la dueña)
  waiterId       String?
  status         TableSessionStatus @default(OPEN)
  openedAt       DateTime           @default(now())
  /// El mesero pidió la cuenta (en el mapa sale "Cuenta"); una comanda nueva lo quita
  billAt         DateTime?
  closedAt       DateTime?
  /// Al cobrar: lo consumido y la propina aceptada (pesos)
  subtotal       Int?
  tip            Int                @default(0)

  organization Organization    @relation(fields: [organizationId], references: [id])
  table        DiningTable     @relation(fields: [tableId], references: [id])
  waiter       StaffMember?    @relation(fields: [waiterId], references: [id], onDelete: SetNull)
  tickets      KitchenTicket[]
  payments     TablePayment[]

  @@index([organizationId, status])
}

enum SalesTax {
  NONE
  /// Impuesto nacional al consumo de restaurantes, 8 %
  INC
  /// IVA 19 %: restaurantes bajo franquicia
  IVA
}

enum TablePayMethod {
  CASH
  /// Transferencia o llave Bre-B (es lo mismo: la llave solo la facilita)
  TRANSFER
  /// Tarjeta en el datáfono
  CARD
}

/// Cómo se pagó una mesa: una forma o varias (la mitad en efectivo y la mitad por transferencia)
model TablePayment {
  id             String         @id @default(cuid())
  organizationId String
  sessionId      String
  method         TablePayMethod
  /// Pesos
  amount         Int
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  session      TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

enum KitchenTicketStatus {
  /// En cocina
  SENT
  /// La cocina lo terminó (descuenta insumos)
  READY
  /// El mesero lo llevó a la mesa
  SERVED
  /// La caja la anuló porque no se hizo: no se cobra ni descuenta insumos (Julieth, 2026-10-21)
  CANCELLED
}

model KitchenTicket {
  id               String              @id @default(cuid())
  organizationId   String
  sessionId        String
  number           Int
  status           KitchenTicketStatus @default(SENT)
  sentAt           DateTime            @default(now())
  readyAt          DateTime?
  servedAt         DateTime?
  /// Anulada desde la caja: cuándo y quién (la dueña la ve en Caja)
  cancelledAt      DateTime?
  cancelledBy      String?
  /// Por qué se anuló (CANCEL_REASONS en restaurant/cancel-reasons.ts)
  cancelReason     String?
  /// Cuándo la dueña revisó la anulación en Caja (null = por revisar)
  cancelReviewedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  session      TableSession @relation(fields: [sessionId], references: [id])
  lines        TicketLine[]

  @@index([organizationId, status])
}

model TicketLine {
  id             String  @id @default(cuid())
  ticketId       String
  presentationId String
  productId      String?
  sizeId         String?
  qty            Int
  /// Precio de cada una al pedirla (pesos)
  unitPrice      Int
  /// "Sin cebolla", "término medio"…
  note           String?

  ticket       KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  presentation Presentation  @relation(fields: [presentationId], references: [id])
}

model StaffMember {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  role            StaffRole
  /// bcrypt del PIN de 4 dígitos (meseros y cocina)
  pinHash         String?
  /// sha256 del enlace fijo (sirve muchas veces, siempre con el PIN); cambiarlo deja sin servir el anterior
  linkHash        String?   @unique
  /// PIN equivocados al abrir el enlace en un aparato nuevo: 5 seguidos lo bloquean 15 minutos
  linkFails       Int       @default(0)
  linkLockedUntil DateTime?
  /// Mesero encargado de caja: cobra cualquier mesa, no solo las suyas
  cashier         Boolean   @default(false)
  createdAt       DateTime  @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  devices      StaffDevice[]
  sessions     TableSession[]

  @@index([organizationId])
}

/// Aparato amarrado (cookie httpOnly `staff_device` = id.secreto; se guarda el sha256 del secreto).
/// Desconectarlo es borrarlo. Los PIN fallidos se cuentan aquí: 5 seguidos lo bloquean 15 minutos.
model StaffDevice {
  id          String    @id @default(cuid())
  staffId     String
  secretHash  String    @unique
  label       String
  failedPins  Int       @default(0)
  lockedUntil DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

/// Inscripción por la página (POST /signup/start) esperando el código del correo.
/// Al verificarlo se crea la empresa y se borra la solicitud.
/// La carta del negocio en PDF (Julieth, 2026-10-20): se pide al inscribirse para comprobar que el negocio es real y
/// servirá para el bot de WhatsApp. Aparte de Organization para no cargar el archivo en cada consulta.
model BusinessMenu {
  id             String   @id @default(cuid())
  organizationId String   @unique
  name           String
  /// Bytes
  size           Int
  data           Bytes
  uploadedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model SignupRequest {
  id            String   @id @default(cuid())
  email         String   @unique
  ownerName     String
  /// Ya cifrada con bcrypt
  passwordHash  String
  businessName  String
  servesTables  Boolean
  /// Solo dígitos, para no dar dos pruebas al mismo número
  whatsapp      String
  termsVersion  String
  /// Instagram o Google Maps del negocio, para comprobar que es real
  findUs        String   @default("")
  /// La carta en PDF (pasa a BusinessMenu al confirmar el código)
  menuName      String?
  menuPdf       Bytes?
  /// sha256 del código de 6 dígitos
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  /// Dueña de la empresa
  ADMIN
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  roles          Role[]   @default([])
  active         Boolean  @default(true)
  /// null solo para SUPER_ADMIN
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  /// Se rechaza todo JWT emitido antes de esta fecha (cerrar sesión en todos lados)
  sessionsInvalidatedAt DateTime?

  /// POST /auth/accept-terms; null = la dueña aún no acepta los términos
  termsAcceptedAt DateTime?
  termsVersion    String?

  /// Cuándo terminó (o saltó) la guía del panel; null = se le muestra al entrar a Hoy
  tourCompletedAt DateTime?
  /// Secciones cuya tarjeta de "primera vez" ya cerró (p. ej. "insumos")
  seenTips        String[]  @default([])

  organization      Organization?  @relation(fields: [organizationId], references: [id])
  billingContactFor Subscription[]

  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cobro (Wompi)
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  /// Precio en centavos COP, como lo espera Wompi
  price        Int
  durationDays Int
  isTrial      Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  wompiPaymentSourceId String?
  wompiCustomerEmail   String?
  currentPeriodEnd     DateTime
  gracePeriodEndsAt    DateTime?
  /// Descuento manual 0-100 que pone el SUPER_ADMIN
  discountPercent      Int                @default(0)
  discountExpiresAt    DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  billingContactUserId String?

  organization   Organization @relation(fields: [organizationId], references: [id])
  plan           Plan         @relation(fields: [planId], references: [id])
  billingContact User?        @relation(fields: [billingContactUserId], references: [id])
  payments       Payment[]

  @@index([billingContactUserId])
}

enum PaymentMethod {
  WOMPI
  CASH
}

model Payment {
  id                 String        @id @default(cuid())
  subscriptionId     String
  wompiTransactionId String?       @unique
  method             PaymentMethod @default(WOMPI)
  /// Centavos COP
  amount             Int
  /// Estado de Wompi: PENDING | APPROVED | DECLINED | ERROR; efectivo = APPROVED
  status             String
  note               String?
  periodStart        DateTime
  periodEnd          DateTime
  createdAt          DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

/// Idempotencia del webhook de Wompi
model WompiWebhookEvent {
  id          String   @id @default(cuid())
  checksum    String   @unique
  processedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Cocina
// Cantidades: los insumos por peso van en gramos, por volumen en ml y por unidad
// en unidades. Dinero en pesos COP (no centavos). Los días van como "AAAA-MM-DD"
// (hora de Bogotá) para no depender de la zona horaria del servidor.
// Colores de tarjeta: banana | strawberry | lilac | peach | sky | mint
// ─────────────────────────────────────────────────────────────────────────────

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String
  bank           String
  type           String
  number         String
  owner          String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Courier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String
  /// Orden en que se les pregunta (0 = principal)
  position       Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  orders       Order[]

  @@index([organizationId])
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contact        String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  color          String   @default("banana")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  supplies     Supply[]
  purchases    Purchase[]

  @@index([organizationId])
}

enum SupplyKind {
  MASS
  VOLUME
  UNIT
}

enum SupplyCategory {
  INGREDIENT
  PACKAGING
}

model Supply {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  kind           SupplyKind
  category       SupplyCategory @default(INGREDIENT)
  /// g, ml o unidades
  stock          Float          @default(0)
  min            Float          @default(0)
  /// Costo promedio por g, ml o unidad (pesos)
  cost           Float          @default(0)
  /// Último precio tal como se escribió: lo pagado (pesos, con centavos) por tanta cantidad (g, ml o und).
  /// Lo fija el formulario del insumo y lo actualiza cada compra; el formulario lo muestra al editar.
  pricePaid      Float?
  priceQty       Float?
  /// Tiene fecha de vencimiento: cada compra pide la fecha y queda como un lote (SupplyBatch)
  perishable     Boolean        @default(false)
  supplierId     String?
  createdAt      DateTime       @default(now())

  organization  Organization       @relation(fields: [organizationId], references: [id])
  supplier      Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseLines PurchaseLine[]
  recipeItems   RecipeItem[]
  productExtras ProductExtra[]
  packItems     PresentationPack[]
  sizePacks     PresentationSize[]
  linePacks     OrderLine[]
  batches       SupplyBatch[]
  waste         SupplyWaste[]

  @@index([organizationId])
}

model Purchase {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String?
  /// AAAA-MM-DD
  date           String
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  supplier     Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines        PurchaseLine[]

  @@index([organizationId])
}

model PurchaseLine {
  id         String @id @default(cuid())
  purchaseId String
  supplyId   String
  /// g, ml o unidades
  qty        Float
  /// Total pagado por esta línea (pesos)
  total      Int

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supply   Supply   @relation(fields: [supplyId], references: [id])
}

model Recipe {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Gramos de masa que rinde una tanda
  yieldGrams     Float
  color          String   @default("banana")
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  items        RecipeItem[]
  lots         DoughLot[]
  waste        DoughWaste[]
  products     Product[]
  extras       ProductExtra[]

  @@index([organizationId])
}

model RecipeItem {
  id       String @id @default(cuid())
  recipeId String
  supplyId String
  qty      Float

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  supply Supply @relation(fields: [supplyId], references: [id])
}

/// Masa ya preparada y guardada (solo productos "por lote")
model DoughLot {
  id             String   @id @default(cuid())
  organizationId String
  recipeId       String
  grams          Float
  left           Float
  /// AAAA-MM-DD
  madeOn         String
  expiresOn      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  recipe       Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Lo que entró de un insumo con vencimiento en una compra: cuánto queda y cuándo vence.
/// Lo que no está en lotes (stock − lotes) no tiene fecha. Reglas en src/kitchen/supply-batches.ts.
model SupplyBatch {
  id             String   @id @default(cuid())
  organizationId String
  supplyId       String
  /// g, ml o unidades que entraron y que quedan
  qty            Float
  left           Float
  /// AAAA-MM-DD: se usa hasta ese día
  expiresOn      String
  /// AAAA-MM-DD de la compra
  receivedOn     String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  supply       Supply       @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplyId])
}

/// Insumo botado (vencido o dañado): lo que se perdió, para Analítica.
model SupplyWaste {
  id             String   @id @default(cuid())
  organizationId String
  supplyId       String
  qty            Float
  /// pesos, con el costo promedio del insumo al botarlo
  cost           Int
  /// AAAA-MM-DD en que se botó
  date           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  supply       Supply       @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
}

/// Masa botada (vencida o dañada): lo que se perdió, para Analítica.
model DoughWaste {
  id             String   @id @default(cuid())
  organizationId String
  recipeId       String
  grams          Float
  /// Lo que costó esa masa, en pesos, con el costo de los insumos al botarla
  cost           Int
  /// AAAA-MM-DD en que se botó
  date           String
  /// AAAA-MM-DD en que vencía (si se botó antes, es más adelante que date)
  expiresOn      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  recipe       Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
}

enum ProductionMode {
  /// Se hace masa por lotes y se guarda
  LOT
  /// Se hace solo con pedido
  ON_DEMAND
}

model Product {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  mode           ProductionMode @default(LOT)
  recipeId       String
  /// Gramos de masa por unidad (dato interno: el cliente no lo ve)
  grams          Float
  /// Figura de la galleta dibujada: "" | choco | roll | bread | pump | star
  look           String         @default("")
  createdAt      DateTime       @default(now())

  organization    Organization       @relation(fields: [organizationId], references: [id])
  recipe          Recipe             @relation(fields: [recipeId], references: [id])
  extras          ProductExtra[]
  inPresentations PresentationItem[]
  orderLines      OrderLine[]

  @@index([organizationId])
}

/// Extra por unidad: un insumo (relleno comprado, capacillo) o una receta
/// propia (relleno hecho: arequipe, ganache), una sola de las dos.
/// qty: en la medida del insumo, o en gramos si es receta.
model ProductExtra {
  id        String  @id @default(cuid())
  productId String
  supplyId  String?
  recipeId  String?
  qty       Float

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supply  Supply? @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  recipe  Recipe? @relation(fields: [recipeId], references: [id], onDelete: Restrict)
}

/// Lo que se vende: una caja o presentación con su precio
/// Cómo se vende: caja armada (siempre lo mismo), por unidad (la clienta elige
/// sabores y cuántas) o por sabor y tamaño (tortas).
enum SaleKind {
  BOX
  UNIT
  SIZES
}

model Presentation {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  kind           SaleKind @default(BOX)
  /// BOX: precio de la caja · UNIT: precio por unidad · SIZES: el del tamaño más barato
  price          Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id])
  items        PresentationItem[]
  pack         PresentationPack[]
  sizes        PresentationSize[]
  orderLines   OrderLine[]
  ticketLines  TicketLine[]
  editions     EditionPresentation[]

  @@index([organizationId])
}

/// BOX: lo que lleva la caja · UNIT y SIZES: los sabores que se pueden elegir (units = 1)
model PresentationItem {
  id             String @id @default(cuid())
  presentationId String
  productId      String
  units          Int
  /// SIZES: lo que se cobra de más por este sabor (pesos)
  surcharge      Int    @default(0)

  presentation Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
}

/// Tamaños de una presentación por sabor y tamaño (Pequeño, Mediano, Grande).
model PresentationSize {
  id             String  @id @default(cuid())
  presentationId String
  name           String
  /// "2 a 4 porciones"
  portions       String  @default("")
  /// Molde o referencia para la cocina: "20 cm"
  mold           String  @default("")
  price          Int
  /// Gramos de masa por molde; 0 = los del producto
  grams          Float   @default(0)
  /// Empaque que se descuenta por cada uno (caja de torta, base)
  packSupplyId   String?
  position       Int     @default(0)

  presentation Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  packSupply   Supply?      @relation(fields: [packSupplyId], references: [id], onDelete: SetNull)
  orderLines   OrderLine[]
}

/// BOX: empaque por caja · UNIT: empaque de siempre, uno por pedido
model PresentationPack {
  id             String @id @default(cuid())
  presentationId String
  supplyId       String
  qty            Float

  presentation Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  supply       Supply       @relation(fields: [supplyId], references: [id])
}

enum DeliveryMode {
  DELIVERY
  PICKUP
}

enum OrderPayment {
  TRANSFER
  CASH
}

enum OrderStatus {
  PENDING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

model Order {
  id             String       @id @default(cuid())
  organizationId String
  number         Int
  customer       String
  phone          String?
  address        String?
  /// AAAA-MM-DD en que se tomó el pedido
  orderedOn      String
  /// AAAA-MM-DD en que se produce
  productionDate String
  delivery       DeliveryMode @default(DELIVERY)
  payment        OrderPayment @default(TRANSFER)
  /// Domicilio cotizado (pesos)
  fee            Int          @default(0)
  status         OrderStatus  @default(PENDING)
  produced       Boolean      @default(false)
  courierId      String?
  /// Cuándo se marcó "Entregado" (el efectivo de un pedido que recogen entra al cajón de ese turno)
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  courier      Courier?     @relation(fields: [courierId], references: [id], onDelete: SetNull)
  lines        OrderLine[]

  @@unique([organizationId, number])
  @@index([organizationId, productionDate])
}

model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  presentationId String
  qty            Int
  /// Precio de la presentación al tomar el pedido (pesos)
  unitPrice      Int
  /// UNIT y SIZES: el sabor elegido
  productId      String?
  /// SIZES: el tamaño elegido
  sizeId         String?
  /// UNIT: otro empaque para este pedido (si no, el de siempre)
  packSupplyId   String?

  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  presentation Presentation      @relation(fields: [presentationId], references: [id])
  product      Product?          @relation(fields: [productId], references: [id])
  size         PresentationSize? @relation(fields: [sizeId], references: [id])
  packSupply   Supply?           @relation(fields: [packSupplyId], references: [id])
}

/// Edición de temporada: se vende hasta la fecha de cierre o hasta completar el cupo
model Edition {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  /// AAAA-MM-DD
  startDate      String
  endDate        String
  look           String   @default("star")
  color          String   @default("strawberry")
  createdAt      DateTime @default(now())

  organization  Organization          @relation(fields: [organizationId], references: [id])
  presentations EditionPresentation[]

  @@index([organizationId])
}

model EditionPresentation {
  editionId      String
  presentationId String

  edition      Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  presentation Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@id([editionId, presentationId])
}

/// Casillas marcadas en "Lista para armar" de un día de producción
model ProductionCheck {
  organizationId String
  /// AAAA-MM-DD
  date           String
  key            String
  done           Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, date, key])
}

// ─────────────────────────────────────────────────────────────────────────────
// Caja: turnos con base y arqueo (Julieth, 2026-10-21; como los informes de caja de Toast o Square)
// ─────────────────────────────────────────────────────────────────────────────

/// Un turno de caja: se abre con la base (el efectivo para dar vueltas) y se cierra contando el efectivo a ciegas.
model CashShift {
  id             String    @id @default(cuid())
  organizationId String
  /// = organizationId mientras está abierto (null al cerrar): así no hay dos turnos abiertos a la vez
  openKey        String?   @unique
  openedAt       DateTime  @default(now())
  openedBy       String
  /// Base con la que se abre, en pesos
  openingCash    Int
  closedAt       DateTime?
  closedBy       String?
  /// Primer conteo que no cuadró (se pidió contar de nuevo)
  firstCount     Int?
  /// Lo contado al cerrar y lo que debía haber (base + efectivo cobrado + entradas − salidas)
  counted        Int?
  expected       Int?
  /// Qué pasó, si no cuadró en el segundo conteo
  note           String?
  /// Cuándo la dueña revisó una diferencia
  reviewedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  moves        CashMove[]

  @@index([organizationId, openedAt])
}

enum CashMoveKind {
  /// Entra efectivo (p. ej. el repartidor entrega lo cobrado)
  IN
  /// Sale efectivo (p. ej. pago a un proveedor)
  OUT
}

/// Efectivo que entra o sale del cajón sin ser una venta, con su motivo.
model CashMove {
  id             String       @id @default(cuid())
  organizationId String
  shiftId        String
  kind           CashMoveKind
  amount         Int
  reason         String
  by             String
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  shift        CashShift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
